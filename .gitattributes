# Normalize to LF in the repository. This matters because the iOS half of the
# build runs on macOS while the backend is developed on Windows — without this,
# every file churns line endings when it crosses machines.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Scripts that must stay LF to be executable
*.sh       text eol=lf
gradlew    text eol=lf

# Binary — never diff or convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.keystore binary
*.jks  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
