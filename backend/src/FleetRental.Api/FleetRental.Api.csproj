<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- See the matching comment in FleetRental.UnitTests.csproj: the revenue
         forecast endpoint depends on Microsoft.ML.TimeSeries' native MKL
         assets, which restore is not guaranteed to fetch for a given OS
         without an explicit RuntimeIdentifiers list — and this API needs to
         run on whichever OS actually hosts it, not just the one it was built on. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pinned above the transitive 2.0.0 pulled in by Microsoft.AspNetCore.OpenApi,
         which carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetRental.Infrastructure\FleetRental.Infrastructure.csproj" />
    <ProjectReference Include="..\FleetRental.Application\FleetRental.Application.csproj" />
  </ItemGroup>

</Project>
