{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // Development-only values. Jwt:Key here is a local signing key and is fine to
  // commit *because it only ever signs tokens on a developer machine* — any
  // deployed environment must supply its own via Jwt__Key or user-secrets, and
  // Program.cs refuses to start without one.
  "Jwt": {
    "Key": "dev-only-signing-key-not-for-any-deployed-environment-32+chars"
  },

  "Seed": {
    "Enabled": true,
    "AdminEmail": "admin@fleetrental.local",
    "AdminPassword": "ChangeMe!2026",
    "AdminFullName": "Fleet Administrator"
  }
}
